<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="12dp"

    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#E3F2FD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TARIKH -->
        <TextView
            android:id="@+id/txtWaterReportDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20/05/2026"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"/>

        <!-- JUMLAH AIR -->
        <TextView
            android:id="@+id/txtWaterReportAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="💧 2.00 L / 3.00 L"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1565C0"/>

        <!-- PERATUS -->
        <TextView
            android:id="@+id/txtWaterReportPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="67% daripada sasaran"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F0583A"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
